generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(cuid())
  name              String
  role              String
  school            String?
  major             String?
  targetRole        String?
  email             String?             @unique
  passwordHash      String?
  phone             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  resume            Resume?
  resumeAnalyses    ResumeAnalysis[]
  jobAnalyses       JobAnalysis[]
  sharePosts        SharePost[]
  discussionPosts   DiscussionPost[]
  discussionReplies DiscussionReply[]
}

model Resume {
  id             String   @id @default(cuid())
  userId         String   @unique
  content        String
  structuredJson String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResumeAnalysis {
  id               String   @id @default(cuid())
  userId           String
  resumeContent    String
  score            Int
  completenessJson String
  issuesJson       String
  keywordJson      String
  fitJson          String
  strengthsJson    String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobAnalysis {
  id                 String   @id @default(cuid())
  userId             String
  jobName            String
  jobDescription     String
  score              Int
  keywordsJson       String
  strengthsJson      String
  gapsJson           String
  deliveryAdviceJson String
  directionsJson     String
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SharePost {
  id         String        @id @default(cuid())
  authorId   String
  title      String
  excerpt    String
  content    String
  category   String
  likes      Int           @default(0)
  views      Int           @default(0)
  favorites  Int           @default(0)
  isHot      Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags       SharePostTag[]
}

model ShareTag {
  id    String        @id @default(cuid())
  name  String        @unique
  posts SharePostTag[]
}

model SharePostTag {
  postId String
  tagId  String
  post   SharePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    ShareTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model DiscussionPost {
  id        String              @id @default(cuid())
  authorId  String
  title     String
  content   String
  category  String
  status    String              @default("讨论中")
  views     Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  author    User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   DiscussionReply[]
  tags      DiscussionPostTag[]
}

model DiscussionTag {
  id    String              @id @default(cuid())
  name  String              @unique
  posts DiscussionPostTag[]
}

model DiscussionPostTag {
  postId String
  tagId  String
  post   DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    DiscussionTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model DiscussionReply {
  id        String         @id @default(cuid())
  postId    String
  authorId  String
  content   String
  likes     Int            @default(0)
  createdAt DateTime       @default(now())
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
