{
  "name": "career-future-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts",
    "serve": "npm run build && node server/index.ts --serve",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:init": "node prisma/init.ts",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:init && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "prisma": "^6.16.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@6.19.2": true,
    "@prisma/engines@6.16.2": true,
    "esbuild@0.27.4": true,
    "prisma@6.16.2": true
  }
}
